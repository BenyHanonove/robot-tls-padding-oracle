# --- Target Settings ---
TARGET_HOST="robot-server"
TARGET_PORT=8443

# --- Attack Performance ---
# Number of parallel probes
ATTACK_CONCURRENCY=50
# Time to wait for server response/reset
ORACLE_TIMEOUT_MS=500

# --- Crypto Information ---
# Path to server certificate (extracted during handshake)
SERVER_CERT_PATH="config/server.crt"

# --- Logging ---
DEBUG_MODE="false"
