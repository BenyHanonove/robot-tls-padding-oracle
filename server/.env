# --- TLS Settings ---
# Force specific versions
TLS_VERSION="1.2"
TLS_VERSION_MIN="1.2"
TLS_VERSION_MAX="1.2"

# --- Cipher Suites ---
# Vulnerable RSA ciphers
VULNERABLE_CIPHER_SUITE="TLS_RSA_WITH_AES_128_CBC_SHA,TLS_RSA_WITH_AES_256_CBC_SHA"
PREFER_SERVER_CIPHERS="true"

# --- Server Network ---
# Port for HTTPS
SERVER_PORT=8443

# --- RSA Key Settings ---
# Standard key size
RSA_KEY_SIZE=2048
SIGNATURE_ALGORITHM="SHA256-RSA"

# --- File Paths ---
# Certificate and key
CERT_FILE_PATH="config/server.crt"
KEY_FILE_PATH="config/server.key"
